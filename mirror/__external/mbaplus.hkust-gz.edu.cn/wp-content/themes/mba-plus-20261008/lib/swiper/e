<script>
  (function () {
    const state = {
      currentYear: '',
      currentMonth: '',
      availableMonths: [],
      years: []
    };

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    // 初始化
    init();

    function init() {
      loadAvailableMonths();
    }

    // 加载可用的年月数据
    function loadAvailableMonths() {
      $.ajax({
        url: '/wp-json/MBAPlus/v1/getavailablemonths',
        type: 'GET',
        dataType: 'json',
        success: function (res) {
          state.availableMonths = res.availableMonths || [];
          state.years = res.years || generateYears();

          initializeFilters();
          determineInitialDate();

          // 先设置筛选器的选中状态
          syncMobileFilter(state.currentYear, state.currentMonth);
          syncDateFilter(state.currentYear, state.currentMonth);

          // 再加载活动数据
          loadEvents(state.currentYear, state.currentMonth);
        },
        error: function (err) {
          console.error('Failed to load available months:', err);
          state.years = generateYears();
          initializeFilters();

          const now = new Date();
          state.currentYear = now.getFullYear().toString();
          state.currentMonth = monthNames[now.getMonth()];

          // 先设置筛选器的选中状态
          syncMobileFilter(state.currentYear, state.currentMonth);
          syncDateFilter(state.currentYear, state.currentMonth);

          // 再加载活动数据
          loadEvents(state.currentYear, state.currentMonth);
        }
      });
    }

    // 生成年份范围（2021年至今）
    function generateYears() {
      const currentYear = new Date().getFullYear();
      const years = [];
      for (let year = currentYear; year >= 2021; year--) {
        years.push(year.toString());
      }
      return years;
    }

    // 初始化筛选器
    function initializeFilters() {
      initializeMobileFilter();
      initializeDateFilter();
    }

    // 初始化移动端筛选器
    function initializeMobileFilter() {
      const $yearSelect = $('#mobile-year-select');
      const $monthSelect = $('#mobile-month-select');

      // 清空现有选项
      $yearSelect.html('');

      // 添加年份选项
      state.years.forEach(function (year) {
        $yearSelect.append(`<option value="${year}">${year}</option>`);
      });

      // 年份选择变化
      $yearSelect.on('change', function () {
        const selectedYear = $(this).val();

        if (selectedYear) {
          state.currentYear = selectedYear;
          updateMonthOptions(selectedYear);
          $monthSelect.prop('disabled', false);
          // 重置月份选择器为默认选项
          $monthSelect.val('');
          state.currentMonth = '';
        } else {
          $monthSelect.prop('disabled', true).val('');
          state.currentMonth = '';
        }
      });

      // 月份选择变化
      $monthSelect.on('change', function () {
        const selectedMonth = $(this).val();

        if (state.currentYear && selectedMonth) {
          state.currentMonth = selectedMonth;
          loadEvents(state.currentYear, state.currentMonth);
          syncDateFilter(state.currentYear, state.currentMonth);
        }
      });
    }

    // 更新月份选项（显示所有12个月，无活动的月份禁用）
    function updateMonthOptions(year) {
      const $monthSelect = $('#mobile-month-select');
      // 根据URL路径设置默认选项文本
      const isChinese = window.location.pathname.includes('/zh');
      const defaultText = isChinese ? '月份' : 'Month';
      // 保留默认选项，只更新后面的月份选项
      $monthSelect.html(`<option value="">${defaultText}</option>`);


      const monthsInYear = state.availableMonths.filter(function (item) {
        return item.year === year;
      });

      // 遍历所有12个月份
      monthNames.forEach(function (month) {
        const hasEvents = monthsInYear.some(function (item) {
          return item.month === month;
        });

        // 如果没有活动，添加 disabled 属性
        if (hasEvents) {
          const option = `<option value="${month}">${month}</option>`;
          $monthSelect.append(option);
        } else {
          const option = `<option value="${month}" disabled>${month}</option>`;
          $monthSelect.append(option);
        }
      });
    }

    // 初始化桌面端日期筛选器
    function initializeDateFilter() {
      const $filterBox = $('#date-filter-box');
      $filterBox.empty();

      state.years.forEach(function (year, index) {
        // 不再使用 inline style，完全由 CSS 和 JS 控制
        let monthsHtml = '';
        monthNames.forEach(function (month) {
          const hasEvents = state.availableMonths.some(function (item) {
            return item.year === year && item.month === month;
          });

          const disabledClass = !hasEvents ? ' disabled' : '';
          monthsHtml += `<div class="month-item${disabledClass}" data-month="${month}">${month}</div>`;
        });

        const yearHtml = `
          <div class="filter-year">
            <div class="year" data-year="${year}">${year}</div>
            <div class="months-list">
              ${monthsHtml}
            </div>
          </div>
        `;

        $filterBox.append(yearHtml);
      });

      bindDateFilterEvents();
    }

    // 绑定日期筛选器事件
    function bindDateFilterEvents() {
      const $filterYears = $('.date-filter .filter-year');

      // 点击年份标题展开/收起（手风琴效果：只允许展开一个）
      $filterYears.on('click', '.year', function () {
        const $parent = $(this).closest('.filter-year');
        const isActive = $parent.hasClass('active');

        // 先关闭所有年份
        $filterYears.removeClass('active');

        // 如果当前年份之前不是展开状态，则展开它
        if (!isActive) {
          $parent.addClass('active');
        }
      });

      // 点击月份项
      $filterYears.on('click', '.month-item:not(.disabled)', function () {
        const $this = $(this);
        const $parentYear = $this.closest('.filter-year');

        // 移除所有年份下的所有月份的current类（全局唯一）
        $('.date-filter .month-item').removeClass('current');

        // 为当前点击的月份添加current类
        $this.addClass('current');

        // 获取选中的年份和月份
        const year = $parentYear.find('.year').data('year');
        const month = $this.data('month');

        state.currentYear = year;
        state.currentMonth = month;

        loadEvents(year, month);
        syncMobileFilter(year, month);
      });
    }

    // 确定初始显示的日期
    function determineInitialDate() {
      const now = new Date();
      const currentYear = now.getFullYear().toString();
      const currentMonth = monthNames[now.getMonth()];

      // 检查当前月是否有活动
      const hasCurrentMonthEvents = state.availableMonths.some(function (item) {
        return item.year === currentYear && item.month === currentMonth;
      });

      if (hasCurrentMonthEvents) {
        state.currentYear = currentYear;
        state.currentMonth = currentMonth;
      } else {
        // 查找最近的有活动的月份
        const nearestMonth = findNearestMonth();
        if (nearestMonth) {
          state.currentYear = nearestMonth.year;
          state.currentMonth = nearestMonth.month;
        } else {
          state.currentYear = currentYear;
          state.currentMonth = currentMonth;
        }
      }
    }

    // 查找最近的有活动的月份
    function findNearestMonth() {
      if (state.availableMonths.length === 0) {
        return null;
      }

      const now = new Date();
      const currentYearMonth = now.getFullYear() * 100 + (now.getMonth() + 1);

      let nearestMonth = null;
      let minDiff = Infinity;

      state.availableMonths.forEach(function (item) {
        const itemYearMonth = parseInt(item.year) * 100 + parseInt(item.month_num);
        const diff = Math.abs(itemYearMonth - currentYearMonth);

        if (diff < minDiff) {
          minDiff = diff;
          nearestMonth = item;
        }
      });

      return nearestMonth;
    }

    // 加载活动列表
    function loadEvents(year, month) {
      showLoading(true);
      hideEmptyMessage();

      let url = '/wp-json/MBAPlus/v1/queryevents';
      let params = {};

      if (year) {
        params.year = year;
      }
      if (month) {
        params.month = month;
      }

      $.ajax({
        url: url,
        data: params,
        type: 'GET',
        dataType: 'json',
        success: function (res) {
          showLoading(false);

          if (res.dataList && res.dataList.length > 0) {
            renderEvents(res.dataList);
            hideEmptyMessage();
          } else {
            showEmptyMessage();
          }
        },
        error: function (err) {
          showLoading(false);
          showEmptyMessage();
          console.error('Failed to load events:', err);
        }
      });
    }

    // 渲染活动列表
    function renderEvents(events) {
      const $eventsList = $('#events-list');
      let html = '';

      // 根据URL路径判断是否为中文页面
      const isChinese = window.location.pathname.includes('/zh');

      // 处理链接的辅助函数
      function processLink(link) {
        if (isChinese && link) {
          // 在域名后添加 /zh
          try {
            const url = new URL(link);
            // 检查路径是否已经以 /zh 开头
            if (!url.pathname.startsWith('/zh')) {
              url.pathname = '/zh' + url.pathname;
            }
            return url.toString();
          } catch (e) {
            // 如果 URL 解析失败，返回原链接
            return link;
          }
        }
        return link;
      }

      events.forEach(function (event) {
        // 如果 video 字段存在且有内容，显示视频图标
        const videoIcon = (event.video) ? '<i class="icon-video"></i>' : '';
        const typeDisplay = event.type || '';

        // 处理链接
        const processedLink = processLink(event.link);

        html += `
          <div class="item">
            <div class="date">
              <div class="day">${event.day}</div>
              <div class="month-year value">
                <p class="en"><span>${event.month}</span>.${event.year}</p>
                <p class="zh"><span>${event.month2}</span>.${event.year}</p>
              </div>
            </div>
            <div class="content">
              <div class="info">
                <div class="type">
                  ${videoIcon}
                  <span>${typeDisplay}</span>
                </div>
                <a href="${processedLink}" class="title">${event.title}</a>
                <div class="details">
                  ${event.speaker ? `
                    <div class="row">
                      <div class="label">Speaker(s)</div>
                      <div class="value">
                        ${event.speaker}
                      </div>
                    </div>
                  ` : ''}
                  <div class="row">
                    <div class="label">Date</div>
                    <div class="value">
                      <p class="en">${event.day} <span>${event.month_full}</span> ${event.year} (<span>${event.week}</span>)</p>
                      <p class="zh">${event.year}年 <span>${event.month_full}</span> ${event.day}日 (<span>${event.week}</span>)</p>
                    </div>
                  </div>
                  <div class="row">
                    <div class="label">Time</div>
                    <div class="value">
                      <p class="en">${event.time_start} <span>${event.time_period}</span> - ${event.time_end} <span>${event.time_period_end}</span></p>
                      <p class="zh"><span>${event.time_period}</span> ${event.time_start} - ${event.time_end === '12:00' ? '' : `<span>${event.time_period_end}</span> `}${event.time_end}</p>
                    </div>
                  </div>
                  ${event.venue ? `
                    <div class="row">
                      <div class="label">Venue</div>
                      <div class="value">${event.venue}</div>
                    </div>
                  ` : ''}
                </div>
              </div>
              <a href="${processedLink}" class="img">
                <img src="${event.thumbnail}" alt="${event.title}">
              </a>
            </div>
          </div>
        `;
      });

      $eventsList.html(html);
    }

    // 同步移动端筛选器状态
    function syncMobileFilter(year, month) {
      const $yearSelect = $('#mobile-year-select');
      const $monthSelect = $('#mobile-month-select');

      // 设置年份选中
      $yearSelect.val(year);

      // 先更新该年份的月份选项
      updateMonthOptions(year);

      // 再设置月份选中
      $monthSelect.val(month);

      // 如果年份已选择，启用月份选择器
      if (year) {
        $monthSelect.prop('disabled', false);
      }
    }

    // 同步桌面端筛选器状态
    function syncDateFilter(year, month) {
      const $filterYears = $('.date-filter .filter-year');

      // 先移除所有年份的active状态和所有月份的current状态
      $filterYears.removeClass('active');
      $('.date-filter .month-item').removeClass('current');

      $filterYears.each(function () {
        const $this = $(this);
        const yearText = $this.find('.year').text();

        if (yearText === year) {
          // 展开对应年份
          $this.addClass('active');

          // 为该年份下的对应月份添加current类
          $this.find('.month-item').each(function () {
            if ($(this).text() === month) {
              $(this).addClass('current');
            }
          });
        }
      });
    }

    // 显示/隐藏加载状态
    function showLoading(show) {
      let $loading = $('#events-list .tip-loading');
      if ($loading.length === 0) {
        $loading = $('<div class="tip-loading" style="display: none;"><div class="box"></div></div>');
        $('#events-list').prepend($loading);
      }
      $loading.css('display', show ? 'block' : 'none');
    }

    // 显示空状态
    function showEmptyMessage() {
      let $empty = $('#events-list .empty-wrap');
      if ($empty.length === 0) {
        $empty = $('<div class="empty-wrap" style="display: none;">No related events were found.</div>');
        $('#events-list').append($empty);
      }
      $empty.css('display', 'block');
    }

    // 隐藏空状态
    function hideEmptyMessage() {
      $('#events-list .empty-wrap').css('display', 'none');
    }

  })();
</script>